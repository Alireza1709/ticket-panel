{
  "name": "@tickets/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test:health": "npm run build && node --test tests/health.test.mjs",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "node --env-file=../.env.demo --import tsx src/seed.ts",
    "test:auth": "npm run build && node --env-file=../.env.demo --test tests/auth.test.mjs",
    "config:session": "node scripts/session-secret.mjs",
    "test:tickets": "npm run build && node --env-file=../.env.demo --test tests/customer-tickets.test.mjs",
    "test:staff": "npm run build && node --env-file=../.env.demo --test tests/staff-tickets.test.mjs",
    "test:production": "npm run build && node --test tests/production-config.test.mjs",
    "staff:provision": "node dist/provision-staff.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
