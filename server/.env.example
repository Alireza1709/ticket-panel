# Copy to server/.env and replace placeholders locally. Never commit credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/tickets_db
# Generate a unique random value of at least 48 characters locally. Not a demo password.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
APP_ORIGIN=http://localhost:5173
