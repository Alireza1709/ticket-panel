[Unit]
Description=Support ticket production API
Wants=postgresql@16-main.service
After=network.target postgresql@16-main.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=drbtest01
Group=drbtest01
WorkingDirectory=/home/drbtest01/tickets-app/server
EnvironmentFile=/etc/tickets-app/server.env
ExecStart=/usr/bin/node /home/drbtest01/tickets-app/server/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
