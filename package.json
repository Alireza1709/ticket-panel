{
  "name": "tickets-app",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces",
    "start": "npm run start -w server",
    "test:health": "npm run test:health -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "test:auth": "npm run test:auth -w server && npm run test:routes -w client",
    "config:session": "npm run config:session -w server",
    "test:tickets": "npm run test:tickets -w server && npm run test:customer -w client"
  }
}
